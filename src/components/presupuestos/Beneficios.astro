---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import reelInstagram from "../../assets/images/presupuestos-reel-instagram.png";

const INSTAGRAM_VIDEO_URL = "https://www.instagram.com/p/DeiJKELFTPm/";
---

<section id="beneficios" class="py-20 sm:py-28 bg-[#0c0817] relative overflow-hidden border-t-4 border-black">
  <!-- Dynamic Background -->
  <div class="absolute inset-0 bg-comic-lines opacity-20 pointer-events-none"></div>
  <div class="absolute -top-24 right-1/4 w-96 h-96 bg-[#9eff00]/5 blur-[120px] rounded-full pointer-events-none animate-pulse"></div>

  <!-- Floating dynamic pop badge in background -->
  <div class="hidden xl:block absolute top-12 right-12 z-0 animate-spin-slow opacity-80 pointer-events-none">
    <div class="w-24 h-24 rounded-full border-2 border-dashed border-[#ffb703] flex items-center justify-center text-[10px] font-black uppercase text-[#ffb703] tracking-widest text-center p-2">
      ★ 100% PRÁCTICO ★
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Title with dynamic scroll reaction -->
    <div
      data-reveal
      data-y="35"
      data-amount="0.2"
      data-duration="0.6"
      data-ease="out"
      class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-14 gap-6"
    >
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-[#ff2a85] text-white px-3.5 py-1 rounded-full font-black text-xs uppercase tracking-wider mb-3 border-2 border-black shadow-[3px_3px_0px_#000] hover:scale-105 transition-transform">
          <Icon name="Zap" class="w-3.5 h-3.5 fill-white text-white animate-zap" />
          <span>Diferenciales únicos del programa</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-none">
          ¿Por qué inscribirse en{" "}
          <span class="text-[#ffb703] underline decoration-lime-400 hover:text-[#9eff00] transition-colors">Póngase Pilas?</span>
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-300 font-medium">
          Diseñado no para entregar diplomas que se queden guardados en un cajón, sino para que monte su propio negocio y comience a facturar con orgullo santandereano.
        </p>
      </div>

      <div
        data-reveal
        data-scale="0.85"
        data-amount="0.2"
        data-duration="0.5"
        data-delay="0.2"
        class="hidden lg:block rotate-2 hover:rotate-0 transition-transform"
      >
        <span class="neo-box-sm bg-[#9eff00] text-black font-black text-xs uppercase tracking-widest px-4 py-2 rounded-xl inline-flex items-center gap-2 animate-button-neon">
          <Icon name="Shield" class="w-4 h-4" /> 100% Avalado por la Alcaldía de Bucaramanga
        </span>
      </div>
    </div>

    <!-- Video Showcase Component with Instagram Thumbnail & Direct Link (Moved ABOVE the 4 cards) -->
    <div
      data-reveal
      data-y="35"
      data-scale="0.98"
      data-amount="0.2"
      data-duration="0.6"
      data-ease="out"
      class="mb-14 sm:mb-16 neo-box bg-gradient-to-r from-[#21113f] via-[#170a2f] to-[#0f061e] p-6 sm:p-8 rounded-3xl border-3 border-[#9eff00] relative overflow-hidden shadow-[8px_8px_0px_#000]"
    >
      <!-- Subtle neon glow in corner -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-[#9eff00]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        <!-- Left: Video Thumbnail with Play Button overlay -->
        <div class="lg:col-span-5 flex justify-center">
          <a
            href={INSTAGRAM_VIDEO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block w-full max-w-[280px] sm:max-w-[300px] aspect-[9/16] rounded-2xl overflow-hidden border-3 border-black shadow-[6px_6px_0px_#000] cursor-pointer hover:scale-[1.02] transition-transform duration-300"
          >
            <!-- Thumbnail image -->
            <Image
              src={reelInstagram}
              alt="Miniatura video oficial Póngase Pilas"
              quality={90}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />

            <!-- Dark vignette overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/30 group-hover:from-black/60 transition-colors"></div>

            <!-- Top Badge: Instagram Reel -->
            <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md text-white border border-white/20 text-[11px] font-black uppercase px-2.5 py-1 rounded-full flex items-center gap-1.5 shadow-md">
              <span class="w-2 h-2 rounded-full bg-[#ff2a85] animate-ping"></span>
              <span>Reel Oficial</span>
            </div>

            <!-- Centered Glowing Play Button -->
            <div class="absolute inset-0 flex flex-col items-center justify-center p-4">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#9eff00] text-black flex items-center justify-center border-3 border-black shadow-[4px_4px_0px_#000] group-hover:scale-110 group-hover:bg-[#ffb703] transition-all animate-button-neon">
                <Icon name="Play" class="w-8 h-8 sm:w-10 sm:h-10 fill-black translate-x-0.5" />
              </div>
              <span class="mt-3 bg-black/90 text-white font-black text-xs uppercase tracking-wider px-3 py-1 rounded-full border border-lime-400 shadow-md group-hover:bg-[#9eff00] group-hover:text-black transition-colors">
                Ver video
              </span>
            </div>

            <!-- Bottom caption overlay -->
            <div class="absolute bottom-3 left-3 right-3 text-center">
              <span class="text-[11px] font-extrabold text-[#affc41] bg-black/80 px-2 py-0.5 rounded border border-lime-400/40">
                ▶ Ver en Instagram · @alcaldiabga
              </span>
            </div>
          </a>
        </div>

        <!-- Right: Explanatory Content & CTA Buttons -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <div class="inline-flex items-center gap-2 bg-[#6a0dad] text-white px-3.5 py-1 rounded-full font-black text-xs uppercase tracking-wider mb-4 border-2 border-black shadow-[3px_3px_0px_#000] self-start">
            <Icon name="Zap" class="w-3.5 h-3.5 fill-[#9eff00] text-[#9eff00] animate-zap" />
            <span>Video Oficial · Convocatoria IMEBU 2026</span>
          </div>

          <h3 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight mb-4">
            Todo lo que necesitas saber:{" "}
            <span class="text-[#9eff00] underline decoration-[#ff2a85] decoration-wavy">
              qué es, cómo inscribirse y qué barrios participan
            </span>
          </h3>

          <p class="text-slate-200 text-base sm:text-lg leading-relaxed mb-6 font-medium">
            Los <strong class="text-[#9eff00] font-bold">Presupuestos Participativos del IMEBU</strong> son la inversión pública que lleva diplomados gratuitos a comunidades de Bucaramanga. En el video oficial conocerá <strong class="text-white font-bold">qué son</strong>, el <strong class="text-[#affc41] font-bold">paso a paso completo para inscribirse</strong> y recibir su kit de emprendimiento y consultar si <strong class="text-[#ffb703] font-bold">su barrio está entre las comunidades participantes</strong>.
          </p>

          <!-- Bullet highlights aligned with video -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
            <div class="flex items-center gap-2 text-xs font-bold text-slate-200 bg-black/40 p-2.5 rounded-xl border border-purple-900/60">
              <span class="w-2.5 h-2.5 rounded-full bg-[#9eff00] shrink-0"></span>
              <span>1. ¿Qué es? Inversión pública comunitaria</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-bold text-slate-200 bg-black/40 p-2.5 rounded-xl border border-purple-900/60">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ffb703] shrink-0"></span>
              <span>2. Su Barrio: Lista de sectores priorizados</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-bold text-slate-200 bg-black/40 p-2.5 rounded-xl border border-purple-900/60">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff2a85] shrink-0"></span>
              <span>3. Paso a Paso: Guía clara de inscripción</span>
            </div>
            <div class="flex items-center gap-2 text-xs font-bold text-slate-200 bg-black/40 p-2.5 rounded-xl border border-purple-900/60">
              <span class="w-2.5 h-2.5 rounded-full bg-[#affc41] shrink-0"></span>
              <span>4. Su Kit: Herramientas de regalo al graduarse</span>
            </div>
          </div>

          <!-- Action Buttons: Only 'Encontrar mi barrio' and 'Paso a paso para inscribirme' -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <a
              href="#oferta"
              data-scroll-to="oferta"
              class="neo-box-sm bg-[#ffb703] hover:bg-[#ffa500] text-black font-black text-xs sm:text-sm px-5 py-3.5 rounded-xl flex items-center justify-center gap-2 shadow-[4px_4px_0px_#000] cursor-pointer transition-all hover:scale-105 active:scale-95 text-center shrink-0"
            >
              <Icon name="MapPin" class="w-4 h-4 text-black shrink-0" />
              <span>Encontrar mi barrio</span>
            </a>

            <a
              href="#paso-a-paso"
              data-scroll-to="paso-a-paso"
              class="neo-box-sm bg-[#9eff00] hover:bg-[#8cee00] text-black font-black text-xs sm:text-sm px-5 py-3.5 rounded-xl flex items-center justify-center gap-2 shadow-[4px_4px_0px_#000] animate-button-neon cursor-pointer transition-all hover:scale-105 active:scale-95 text-center shrink-0"
            >
              <Icon name="ListOrdered" class="w-4 h-4 text-black shrink-0 stroke-[2.5]" />
              <span>Paso a paso para inscribirme</span>
            </a>
          </div>

          <span class="text-xs text-slate-400 font-medium text-center sm:text-left mt-3 block">
            Presupuestos Participativos 2026 · IMEBU & Alcaldía de Bucaramanga
          </span>
        </div>
      </div>
    </div>

    <!-- Asymmetrical Editorial Composition with motion on cards (Now positioned below the Video Showcase) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8">
      <!-- Card 1 (01 PROTAGONISTA): Se Gradúa con Kit -->
      <div
        data-reveal
        data-y="35"
        data-scale="0.96"
        data-amount="0.15"
        data-duration="0.5"
        data-delay="0.05"
        class="motion-hover [--hy:-6px] [--hs:1.015] md:col-span-7 neo-box bg-gradient-to-br from-[#3b0a2c] via-[#26051c] to-[#12030d] p-6 sm:p-8 rounded-3xl border-3 border-[#ff2a85] relative overflow-hidden group transition-all ring-2 ring-[#ff2a85]/40 shadow-[6px_6px_0px_#000]"
      >
        <!-- Glowing highlight in background -->
        <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#ff2a85]/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="absolute top-0 right-0 bg-[#ff2a85] text-white font-black text-xs uppercase px-4 py-1.5 rounded-bl-2xl border-l-2 border-b-2 border-black flex items-center gap-1.5 shadow-sm">
          <Icon name="Sparkles" class="w-3.5 h-3.5 animate-pulse" />
          <span>01 · Su Dotación · Protagónico</span>
        </div>

        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 rounded-2xl bg-[#ff2a85] text-white flex items-center justify-center border-2 border-black shadow-[4px_4px_0px_#000] group-hover:scale-110 group-hover:rotate-6 transition-transform">
            <Icon name="Gift" class="w-9 h-9 stroke-[2.5]" />
          </div>
          <span class="neo-box-sm bg-[#9eff00] text-black font-black text-[11px] uppercase tracking-wider px-3 py-1 rounded-full border border-black animate-button-neon">
            ★ Gran Beneficio Principal ★
          </span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3 group-hover:text-[#ff2a85] transition-colors leading-tight">
          Se gradúa con kit de herramientas
        </h3>

        <p class="text-slate-200 text-base sm:text-lg leading-relaxed mb-6 font-normal">
          Al terminar y certificar su formación técnica recibe un <strong class="text-[#ff2a85] font-bold">kit completo de herramientas e insumos propios</strong> de su oficio para poner en marcha su emprendimiento o autoempleo sin deudas ni pedir préstamos informales. ¡El puente directo para empezar a ganar dinero!
        </p>

        <!-- Feature tags -->
        <div class="flex flex-wrap gap-2 pt-4 border-t border-pink-500/30">
          <span class="text-xs font-bold bg-black/60 text-pink-200 border border-pink-400/50 px-3 py-1 rounded-lg flex items-center gap-1 group-hover:border-[#ff2a85] transition-colors">
            <Icon name="Check" class="w-3.5 h-3.5 text-[#ff2a85]" /> Herramientas de trabajo propias
          </span>
          <span class="text-xs font-bold bg-black/60 text-pink-200 border border-pink-400/50 px-3 py-1 rounded-lg flex items-center gap-1 group-hover:border-[#ff2a85] transition-colors">
            <Icon name="Check" class="w-3.5 h-3.5 text-[#ff2a85]" /> Insumos para sus primeros clientes
          </span>
          <span class="text-xs font-bold bg-black/60 text-pink-200 border border-pink-400/50 px-3 py-1 rounded-lg flex items-center gap-1 group-hover:border-[#ff2a85] transition-colors">
            <Icon name="Check" class="w-3.5 h-3.5 text-[#ff2a85]" /> Cero endeudamiento inicial
          </span>
        </div>
      </div>

      <!-- Card 2: Aprende a Vender -->
      <div
        data-reveal
        data-y="35"
        data-scale="0.96"
        data-amount="0.15"
        data-duration="0.5"
        data-delay="0.15"
        class="motion-hover [--hy:-6px] [--hs:1.015] md:col-span-5 neo-box bg-gradient-to-br from-[#2f1b0a] via-[#201206] to-[#140b04] p-6 sm:p-8 rounded-3xl border-3 border-[#ffb703] relative overflow-hidden group transition-all shadow-[6px_6px_0px_#000]"
      >
        <div class="absolute top-0 right-0 bg-[#ffb703] text-black font-black text-xs uppercase px-4 py-1.5 rounded-bl-2xl border-l-2 border-b-2 border-black flex items-center gap-1.5">
          <span>02 · Finanzas</span>
        </div>

        <div class="w-14 h-14 rounded-2xl bg-[#ffb703] text-black flex items-center justify-center border-2 border-black shadow-[4px_4px_0px_#000] mb-6 group-hover:scale-110 group-hover:rotate-6 transition-transform">
          <Icon name="TrendingUp" class="w-8 h-8 stroke-[2.5]" />
        </div>

        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3 group-hover:text-[#ffb703] transition-colors">
          Aprende a vender
        </h3>

        <p class="text-slate-300 text-base leading-relaxed mb-6">
          Saber un oficio no basta si no sabe cobrarlo. Cada diplomado incluye un componente transversal de <strong class="text-[#ffb703] font-bold">gestión comercial, costeo real y liderazgo</strong>.
        </p>

        <div class="bg-black/50 p-4 rounded-xl border border-amber-500/40 space-y-2 group-hover:border-amber-400 transition-colors">
          <div class="flex items-center gap-2 text-xs font-bold text-amber-200">
            <Icon name="Tag" class="w-3.5 h-3.5 text-[#ffb703] animate-pulse" />
            <span>Cómo fijar precios con margen de ganancia</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-amber-200">
            <Icon name="Layers" class="w-3.5 h-3.5 text-[#ffb703]" />
            <span>Calcular costos de materia prima y mano de obra</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-bold text-amber-200">
            <Icon name="Sparkles" class="w-3.5 h-3.5 text-[#ffb703]" />
            <span>Cómo mostrar su negocio en redes y atraer clientas</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Aprende Haciendo -->
      <div
        data-reveal
        data-y="35"
        data-scale="0.96"
        data-amount="0.15"
        data-duration="0.5"
        data-delay="0.25"
        class="motion-hover [--hy:-6px] [--hs:1.015] md:col-span-5 neo-box bg-gradient-to-br from-[#1d2716] via-[#151c10] to-[#0d140a] p-6 sm:p-8 rounded-3xl border-3 border-[#9eff00] relative overflow-hidden group transition-all shadow-[6px_6px_0px_#000]"
      >
        <div class="absolute top-0 right-0 bg-[#9eff00] text-black font-black text-xs uppercase px-4 py-1.5 rounded-bl-2xl border-l-2 border-b-2 border-black flex items-center gap-1.5">
          <span>03 · Taller Vivo</span>
        </div>

        <div class="w-14 h-14 rounded-2xl bg-[#9eff00] text-black flex items-center justify-center border-2 border-black shadow-[4px_4px_0px_#000] mb-6 group-hover:scale-110 group-hover:-rotate-6 transition-transform">
          <Icon name="Hammer" class="w-8 h-8 stroke-[2.5]" />
        </div>

        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3 group-hover:text-[#9eff00] transition-colors">
          Aprende haciendo
        </h3>

        <p class="text-slate-300 text-base leading-relaxed mb-5">
          Clases prácticas, con <strong class="text-[#9eff00] font-bold">maquinaria, materiales y técnicas reales del oficio</strong>. Olvídese de diapositivas aburridas: aquí se corta con máquina de poste, se sublima con prensas térmicas y se trabaja con materiales reales desde el día uno.
        </p>

        <div class="flex flex-wrap gap-2 pt-4 border-t border-lime-500/20">
          <span class="text-xs font-bold bg-black/60 text-lime-300 border border-lime-400/50 px-2.5 py-1 rounded-lg flex items-center gap-1">
            <Icon name="Check" class="w-3.5 h-3.5 text-[#9eff00]" /> Maquinaria industrial
          </span>
          <span class="text-xs font-bold bg-black/60 text-lime-300 border border-lime-400/50 px-2.5 py-1 rounded-lg flex items-center gap-1">
            <Icon name="Check" class="w-3.5 h-3.5 text-[#9eff00]" /> Insumos reales incluidos
          </span>
        </div>
      </div>

      <!-- Card 4: Cerca de su casa -->
      <div
        data-reveal
        data-y="35"
        data-scale="0.96"
        data-amount="0.15"
        data-duration="0.5"
        data-delay="0.35"
        class="motion-hover [--hy:-6px] [--hs:1.015] md:col-span-7 neo-box bg-gradient-to-br from-[#201048] via-[#160a33] to-[#0c051d] p-6 sm:p-8 rounded-3xl border-3 border-purple-400 relative overflow-hidden group transition-all shadow-[6px_6px_0px_#000]"
      >
        <div class="absolute top-0 right-0 bg-purple-500 text-white font-black text-xs uppercase px-4 py-1.5 rounded-bl-2xl border-l-2 border-b-2 border-black flex items-center gap-1.5">
          <span>04 · En su Territorio</span>
        </div>

        <div class="w-14 h-14 rounded-2xl bg-[#6a0dad] text-white flex items-center justify-center border-2 border-black shadow-[4px_4px_0px_#000] mb-6 group-hover:scale-110 group-hover:rotate-6 transition-transform">
          <Icon name="MapPin" class="w-8 h-8 stroke-[2.5] text-[#9eff00]" />
        </div>

        <h3 class="text-2xl sm:text-3xl font-black text-white mb-3 group-hover:text-[#9eff00] transition-colors">
          Cerca de su casa
        </h3>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-6 font-normal">
          La formación está pensada <strong class="text-white font-bold">para barrios y zonas específicas de Bucaramanga</strong>. No tiene que gastar dinero en pasajes diarios ni cruzar la ciudad: las sedes y talleres se ubican en puntos estratégicos comunitarios de su propio sector.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 pt-4 border-t border-purple-800/60 text-xs font-bold text-purple-200">
          <div class="bg-purple-950/80 p-2 rounded-lg border border-purple-800/80 hover:border-lime-400 transition-colors">
            📍 Comuna 1 & 2 (Norte)
          </div>
          <div class="bg-purple-950/80 p-2 rounded-lg border border-purple-800/80 hover:border-lime-400 transition-colors">
            📍 Comuna 14 (Morrorrico)
          </div>
          <div class="bg-purple-950/80 p-2 rounded-lg border border-purple-800/80 hover:border-lime-400 transition-colors">
            📍 Comuna 4 & 10 (Occidente y Sur)
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
