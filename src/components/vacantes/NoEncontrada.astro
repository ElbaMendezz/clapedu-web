---
import Icon from "../presupuestos/Icon.astro";
---

<section class="no-encontrada">
  <div class="aro" aria-hidden="true"></div>

  <div class="vac-container relativo">
    <div class="cuerpo">
      <p class="sobretitulo">Error 404</p>
      <h1>Esta vacante ya no está disponible</h1>
      <p class="descripcion">
        Puede que la convocatoria haya sido retirada o que el enlace esté incompleto. Explora las
        vacantes que tenemos abiertas ahora mismo.
      </p>
      <a href="/vacantes#vacantes" class="boton">
        Ver vacantes disponibles
        <Icon name="ArrowRight" width="16" height="16" stroke-width="2.4" />
      </a>
    </div>
  </div>
</section>

<style>
  .no-encontrada {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 70vh;
    padding: 128px 0 80px;
    background: linear-gradient(120deg, #2a1457, #43197c 38%, #3b2a8a 62%, #13b89a);
    background-size: 220% 220%;
    animation: clap-gradient-shift 16s ease infinite;
  }
  .aro {
    position: absolute;
    right: -112px;
    bottom: -144px;
    width: 460px;
    height: 460px;
    border: 1px solid rgba(59, 224, 187, 0.3);
    border-radius: 50%;
    pointer-events: none;
  }
  .relativo {
    position: relative;
    width: 100%;
  }
  .cuerpo {
    max-width: 640px;
  }

  .sobretitulo {
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  h1 {
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3.35rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: #fff;
    text-wrap: balance;
  }
  .descripcion {
    margin-bottom: 32px;
    font-size: 16.5px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.9);
  }

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: 46px;
    background: var(--color-teal);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 16px 40px -12px rgba(59, 224, 187, 0.55);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .boton:hover {
    background: var(--vac-yellow);
    transform: translateY(-2px);
  }
  .boton:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .no-encontrada {
      animation: none;
    }
  }
</style>
