---
import BotonCopiar from "./BotonCopiar.astro";
import { TALENTO_HUMANO_EMAIL } from "../../data/vacantes";

interface Props {
  /** Total de vacantes publicadas, para el botón "Ver todas". */
  total: number;
  /** Visible desde el servidor solo cuando no hay ninguna vacante; el filtro
   * lo muestra al elegir un área sin convocatorias. */
  oculto: boolean;
}

const { total, oculto } = Astro.props;
---

<div class="vacio" data-vacio hidden={oculto}>
  <div class="pildora">
    <span class="pildora-punto" aria-hidden="true"></span>
    <span class="pildora-texto" data-vacio-etiqueta>Convocatorias</span>
  </div>

  <h3 data-vacio-titulo>En este momento no tenemos convocatorias abiertas</h3>

  <p>
    Puedes explorar las vacantes activas en otras áreas de CLAP o enviarnos tu hoja de vida a{" "}
    <a href={`mailto:${TALENTO_HUMANO_EMAIL}`}>{TALENTO_HUMANO_EMAIL}</a>{" "}
    para tenerte en cuenta en futuras convocatorias de este equipo.
  </p>

  <div class="botones">
    <button type="button" class="ver-todas" data-ver-todas hidden>
      Ver todas las vacantes ({total})
    </button>

    <BotonCopiar
      variante="vacio"
      texto={TALENTO_HUMANO_EMAIL}
      etiqueta="Copiar correo de Talento Humano"
      etiquetaCopiado="Correo copiado al portapapeles"
    />
  </div>
</div>

<style>
  .vacio {
    max-width: 680px;
    margin: 0 auto;
    padding: 32px;
    text-align: center;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 26px;
    box-shadow: 0 20px 44px -30px rgba(52, 28, 101, 0.22);
  }
  .vacio[hidden] {
    display: none;
  }

  .pildora {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 14px;
    margin-bottom: 16px;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--vac-surface);
  }
  .pildora-punto {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vac-muted);
  }
  .pildora-texto {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink-soft);
  }

  h3 {
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 23px;
    color: var(--color-ink);
    text-wrap: balance;
  }

  p {
    max-width: 540px;
    margin: 0 auto 28px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }
  p a {
    font-weight: 600;
    color: var(--color-ink-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  p a:hover {
    color: var(--vac-green);
  }

  .botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .ver-todas {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border: 0;
    border-radius: 46px;
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14.5px;
    cursor: pointer;
    transition: background-color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ver-todas[hidden] {
    display: none;
  }
  .ver-todas:hover {
    background: var(--color-ink-strong);
  }

  @media (min-width: 640px) {
    .vacio {
      padding: 48px;
    }
    h3 {
      font-size: 25px;
    }
  }
</style>
