---
import Icon from "../presupuestos/Icon.astro";
import EstadoConvocatoria from "./EstadoConvocatoria.astro";

interface Props {
  cargo: string;
  activa: boolean;
}

const { cargo, activa } = Astro.props;
---

<section class="detalle-hero">
  <div class="aro" aria-hidden="true"></div>

  <div class="vac-container relativo">
    <div class="volver">
      <a href="/vacantes#vacantes">
        <Icon name="ArrowLeft" width="16" height="16" stroke-width="2.4" />
        Volver a todas las vacantes
      </a>
    </div>

    <div class="cuerpo">
      <EstadoConvocatoria activa={activa} variante="hero" />
      <h1>{cargo}</h1>
    </div>
  </div>
</section>

<style>
  .detalle-hero {
    position: relative;
    overflow: hidden;
    padding: 112px 0 56px;
    background: linear-gradient(120deg, #2a1457, #43197c 38%, #3b2a8a 62%, #13b89a);
    background-size: 220% 220%;
    animation: clap-gradient-shift 16s ease infinite;
  }

  .aro {
    position: absolute;
    right: -112px;
    bottom: -144px;
    width: 460px;
    height: 460px;
    border: 1px solid rgba(59, 224, 187, 0.3);
    border-radius: 50%;
    pointer-events: none;
  }
  .relativo {
    position: relative;
  }

  .volver {
    display: flex;
    align-items: center;
    margin-bottom: 28px;
  }
  .volver a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    border-radius: 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--color-teal);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .volver a:hover {
    color: #fff;
  }
  .volver a:focus-visible {
    outline: 2px solid var(--color-teal);
    outline-offset: 4px;
  }

  .cuerpo {
    max-width: 820px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3.35rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: #fff;
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    .detalle-hero {
      padding: 128px 0 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .detalle-hero {
      animation: none;
    }
  }
</style>
