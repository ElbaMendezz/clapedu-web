---
import Icon from "../presupuestos/Icon.astro";

const WHATSAPP_VOLUNTARIO =
  "https://api.whatsapp.com/send/?phone=3114481160&text&type=phone_number&app_absent=0&utm_source=ig";

interface Unidad {
  indice: string;
  nombre: string;
  descripcion: string;
  href: string;
  externo?: boolean;
}

const unidades: Unidad[] = [
  {
    indice: "01.",
    nombre: "Formación y Programas CLAP",
    descripcion:
      "Programas especializados para formar agentes de cambio y líderes capaces de convertir desafíos sociales en soluciones reales.",
    href: "/programas",
  },
  {
    indice: "02.",
    nombre: "Hub Creativo",
    descripcion:
      "Espacios colaborativos, salas de trabajo y auditorio en Bucaramanga diseñados para crear y conectar en comunidad.",
    href: "/#espacios",
  },
  {
    indice: "03.",
    nombre: "Urbit Lab & Proyectos",
    descripcion:
      "Conocimiento técnico aplicado a retos complejos y soluciones territoriales con impacto social y ambiental.",
    href: "https://urbitlab.pro/",
    externo: true,
  },
  {
    indice: "04.",
    nombre: "Uled",
    descripcion:
      "La primera institución de educación dual del nororiente colombiano, articulando aprendizaje práctico y sector productivo.",
    href: "/#ecosistema",
  },
];
---

<!-- Bloque editorial sobre el ecosistema de trabajo CLAP -->
<section id="cultura-clap" class="entorno">
  <div class="aro-entorno" aria-hidden="true"></div>

  <div class="vac-container relativo">
    <div class="rejilla">
      <div class="intro">
        <p class="sobretitulo">Nuestro entorno</p>
        <h2>Trabaja dentro del <span class="acento">Ecosistema CLAP</span></h2>
        <p class="descripcion">
          Quienes se integran a nuestro equipo colaboran transversalmente con las iniciativas,
          empresas y programas que conforman el Centro Latinoamericano del Propósito.
        </p>
        <a href="/equipo" class="enlace-equipo">
          Conoce a nuestro equipo actual
          <span class="circulo">
            <Icon name="ArrowUpRight" width="16" height="16" stroke-width="2.3" />
          </span>
        </a>
      </div>

      <div class="unidades">
        {
          unidades.map((unidad) => (
            <a
              href={unidad.href}
              target={unidad.externo ? "_blank" : undefined}
              rel={unidad.externo ? "noopener noreferrer" : undefined}
              class="unidad"
            >
              <div class="unidad-cabecera">
                <span class="unidad-indice">{unidad.indice}</span>
                <Icon name="ArrowUpRight" width="16" height="16" class="unidad-flecha" />
              </div>
              <h3>{unidad.nombre}</h3>
              <p>{unidad.descripcion}</p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Llamada a la acción complementaria (voluntariado y comunidad CLAP) -->
<section class="cta">
  <div class="aro-cta" aria-hidden="true"></div>

  <div class="vac-container relativo">
    <div class="cta-fila">
      <div class="cta-texto">
        <p class="cta-sobretitulo">Otras formas de vincularte</p>
        <h2>¿Quieres aportar desde el voluntariado o conocer nuestra filosofía?</h2>
        <p class="cta-descripcion">
          Además de nuestras vacantes laborales, en CLAP contamos con espacios permanentes para
          voluntarios, aliados y jóvenes líderes en toda la región.
        </p>
      </div>

      <div class="cta-botones">
        <a href={WHATSAPP_VOLUNTARIO} target="_blank" rel="noopener noreferrer" class="boton boton--primario">
          Sé voluntario
          <Icon name="ArrowUpRight" width="16" height="16" stroke-width="2.4" />
        </a>

        <a href="/sobre-nosotros#que-es" class="boton boton--secundario">
          Sobre nosotros
          <Icon name="ArrowUpRight" width="16" height="16" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Nuestro entorno ---- */
  .entorno {
    position: relative;
    overflow: hidden;
    padding: 64px 0;
    background: #fff;
  }
  .aro-entorno {
    position: absolute;
    right: -112px;
    bottom: -112px;
    width: 440px;
    height: 440px;
    border: 2px solid rgba(123, 77, 255, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }
  .relativo {
    position: relative;
  }

  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .sobretitulo {
    margin-bottom: 10px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-strong);
  }

  .entorno h2 {
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.9rem, 3.2vw, 2.65rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .acento {
    color: var(--color-teal-dark);
  }

  .descripcion {
    margin-bottom: 24px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--vac-body);
  }

  .enlace-equipo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .enlace-equipo:hover {
    color: var(--color-ink-strong);
  }
  .circulo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(67, 25, 124, 0.1);
    color: var(--color-ink-strong);
    transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .enlace-equipo:hover .circulo {
    background: var(--color-teal);
    color: var(--color-ink);
  }

  .unidades {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .unidad {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    background: var(--vac-surface-card);
    border: 1px solid var(--color-border);
    border-radius: 24px;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .unidad:hover {
    background: #fff;
    transform: translateY(-4px);
    box-shadow: 0 22px 44px -28px rgba(52, 28, 101, 0.32);
  }
  .unidad-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .unidad-indice {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13px;
    color: var(--color-teal-dark);
    font-variant-numeric: tabular-nums;
  }
  .unidad :global(.unidad-flecha) {
    color: var(--vac-muted);
    transition: color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .unidad:hover :global(.unidad-flecha) {
    color: var(--color-ink-strong);
  }
  .unidad h3 {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
    line-height: 1.375;
    color: var(--color-ink);
  }
  .unidad p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* ---- Otras formas de vincularte ---- */
  .cta {
    position: relative;
    overflow: hidden;
    padding: 64px 0;
    background: linear-gradient(125deg, #2a1457, #43197c 45%, #13b89a);
    background-size: 200% 200%;
    animation: clap-gradient-shift 18s ease infinite;
  }
  .aro-cta {
    position: absolute;
    left: -128px;
    bottom: -176px;
    width: 560px;
    height: 560px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 50%;
    pointer-events: none;
  }

  .cta-fila {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  .cta-texto {
    max-width: 640px;
  }
  .cta-sobretitulo {
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .cta h2 {
    margin-bottom: 12px;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.75rem, 3vw, 2.45rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  .cta-descripcion {
    font-size: 15.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }

  .cta-botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    flex: none;
    gap: 16px;
  }
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: none;
    font-family: var(--font-display);
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 46px;
  }
  .boton--primario {
    padding: 16px 28px;
    font-weight: 700;
    color: var(--color-ink);
    background: var(--color-teal);
    box-shadow: 0 16px 36px -14px rgba(59, 224, 187, 0.55);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .boton--primario:hover {
    background: var(--vac-yellow);
  }
  .boton--secundario {
    padding: 16px 24px;
    font-weight: 600;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition:
      color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .boton--secundario:hover {
    color: var(--color-teal);
    border-color: var(--color-teal);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta {
      animation: none;
    }
  }

  @media (min-width: 640px) {
    .entorno {
      padding: 96px 0;
    }
    .descripcion {
      font-size: 16px;
    }
    .unidades {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .unidad {
      padding: 28px;
    }
    .cta {
      padding: 80px 0;
    }
    .cta-descripcion {
      font-size: 16px;
    }
  }

  @media (min-width: 1024px) {
    .rejilla {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 56px;
    }
    .intro {
      grid-column: span 5 / span 5;
    }
    .unidades {
      grid-column: span 7 / span 7;
    }
    .cta-fila {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
