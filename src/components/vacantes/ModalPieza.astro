---
import Icon from "../presupuestos/Icon.astro";

interface Props {
  /** URL de la pieza gráfica: viene de la hoja (remota), por eso no pasa por <Image>. */
  src: string;
  cargo: string;
}

const { src, cargo } = Astro.props;
---

<dialog class="pieza" data-pieza aria-label={`Pieza oficial de la convocatoria ${cargo}`}>
  <div class="caja">
    <button type="button" class="cerrar" aria-label="Cerrar vista previa" data-cerrar-pieza>
      <Icon name="X" width="20" height="20" />
    </button>
    <img
      src={src}
      alt={`Convocatoria oficial ${cargo} - CLAP`}
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
    />
  </div>
</dialog>

<style>
  .pieza {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 16px;
    border: 0;
    overflow: auto;
    background: rgba(15, 8, 34, 0.9);
    backdrop-filter: blur(12px);
    color: inherit;
  }
  .pieza[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pieza::backdrop {
    background: transparent;
  }

  .caja {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 520px;
  }

  .cerrar {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    width: 40px;
    height: 40px;
    margin-bottom: 12px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cerrar:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  img {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  @media (min-width: 640px) {
    .pieza {
      padding: 24px;
    }
  }
</style>
