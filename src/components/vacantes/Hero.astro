---
import { Image } from "astro:assets";
import Icon from "../presupuestos/Icon.astro";
import heroProfesionales from "../../assets/images/vacantes-hero.webp";
---

<section id="inicio-empleos" class="hero">
  <div class="media" aria-hidden="true">
    <Image
      src={heroProfesionales}
      alt=""
      width={2400}
      height={1600}
      widths={[640, 960, 1280, 1920]}
      loading="eager"
      fetchpriority="high"
      layout="constrained"
    />
  </div>

  <!-- Velo institucional morado y turquesa de CLAP para contraste y coherencia de marca -->
  <div class="velo" aria-hidden="true"></div>
  <div class="velo-superior" aria-hidden="true"></div>

  <!-- Aros geométricos orbitales sutiles del Manual de Marca CLAP -->
  <div class="aro aro--a" aria-hidden="true"></div>
  <div class="aro aro--b" aria-hidden="true"></div>

  <div class="vac-container contenido">
    <div class="texto">
      <div class="insignia">
        <span class="insignia-punto" aria-hidden="true"></span>
        <span class="insignia-texto">Trabaja con nosotros</span>
      </div>

      <h1>
        Suma tu talento al equipo que transforma desafíos en
        <span class="acento">soluciones reales</span>
      </h1>

      <p>
        En el Centro Latinoamericano del Propósito impulsamos iniciativas de educación, innovación y
        articulación empresarial. Conoce nuestras convocatorias abiertas y haz parte de nuestra
        organización.
      </p>

      <div class="acciones">
        <a href="#vacantes" class="boton boton--primario">
          Explorar vacantes
          <Icon name="ArrowDownRight" width="16" height="16" stroke-width="2.4" />
        </a>

        <a href="#cultura-clap" class="boton boton--secundario">
          Conoce nuestro ecosistema
          <Icon name="ArrowUpRight" width="16" height="16" class="flecha" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 540px;
    padding: 112px 0 80px;
    background: var(--vac-deep);
  }

  .media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  .velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      102deg,
      rgba(32, 14, 72, 0.92) 0%,
      rgba(52, 28, 101, 0.8) 45%,
      rgba(52, 28, 101, 0.46) 75%,
      rgba(19, 184, 154, 0.35) 100%
    );
  }
  .velo-superior {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 112px;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(20, 10, 46, 0.6), transparent);
    background: linear-gradient(to bottom in oklab, rgba(20, 10, 46, 0.6), transparent);
  }

  .aro {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .aro--a {
    right: -180px;
    bottom: -220px;
    width: 580px;
    height: 580px;
    border: 1px solid rgba(59, 224, 187, 0.25);
  }
  .aro--b {
    right: -90px;
    bottom: -130px;
    width: 410px;
    height: 410px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .contenido {
    position: relative;
    width: 100%;
  }
  .texto {
    max-width: 660px;
  }

  .insignia {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px;
    margin-bottom: 24px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(4px);
  }
  .insignia-punto {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-teal);
  }
  .insignia-texto {
    font-size: 13.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
    margin-bottom: 24px;
    filter: drop-shadow(0 4px 24px rgba(20, 9, 42, 0.35));
  }
  .acento {
    color: var(--color-teal);
  }

  p {
    max-width: 560px;
    margin-bottom: 36px;
    font-size: 16.5px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.9);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    font-family: var(--font-display);
    font-size: 15.5px;
    text-decoration: none;
    white-space: nowrap;
    border-radius: 46px;
  }
  .boton:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .boton--primario {
    gap: 10px;
    padding: 16px 28px;
    font-weight: 700;
    color: var(--color-ink);
    background: var(--color-teal);
    box-shadow: 0 16px 40px -12px rgba(59, 224, 187, 0.55);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .boton--primario:hover {
    background: var(--vac-yellow);
    transform: translateY(-2px);
  }

  .boton--secundario {
    gap: 8px;
    padding: 16px 24px;
    font-weight: 600;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(4px);
    transition:
      color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .boton--secundario:hover {
    color: var(--color-teal);
    border-color: var(--color-teal);
  }
  .boton--secundario:focus-visible {
    outline-color: var(--color-teal);
  }
  .boton--secundario :global(.flecha) {
    color: var(--color-teal);
  }

  @media (min-width: 640px) {
    .hero {
      min-height: 580px;
      padding: 128px 0 96px;
    }
    p {
      font-size: 18px;
    }
    .boton {
      font-size: 16px;
    }
    .boton--primario {
      padding: 16px 32px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      min-height: 620px;
    }
  }
</style>
