---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ToTopButton from "../components/layout/ToTopButton.astro";
import BaseHead from "../components/layout/BaseHead.astro";
import type { BreadcrumbItem } from "../components/layout/BaseHead.astro";
import "../styles/global.css";
import montserratVariableUrl from "../assets/fonts/Montserrat-Variable.woff2?url";
import proximaNovaSemiboldUrl from "../assets/fonts/ProximaNova-Semibold.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Palabras clave para <meta name="keywords">. Ver BaseHead.astro. */
  keywords?: string;
  /** Título exacto para <title>/og:title/twitter:title, sin el sufijo
   * estándar. Ver BaseHead.astro. */
  titleOverride?: string;
  /** Ruta relativa al sitio, ej. "/sobre-nosotros". Default: "/". */
  path?: string;
  /** Imagen para Open Graph / Twitter Card. Ver BaseHead.astro. */
  ogImage?: string;
  /** Dimensiones reales de `ogImage`. Ver BaseHead.astro. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  /** Resalta el trigger del dropdown de nav correspondiente, ver Header.astro. */
  activeDropdown?: "conocenos" | "educacion";
  /** Resalta el ítem activo dentro del submenu desplegado, ver Header.astro. */
  activeNavLink?: "metodologia" | "equipo" | "programas" | "vacantes";
}

const { activeDropdown, activeNavLink, ...head } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead {...head}>
      <link rel="preload" href={montserratVariableUrl} as="font" type="font/woff2" crossorigin />
      <link rel="preload" href={proximaNovaSemiboldUrl} as="font" type="font/woff2" crossorigin />
      <!-- Para que una página inyecte tags propios en el <head> (p. ej. JSON-LD) -->
      <slot name="head" />
    </BaseHead>
  </head>
  <body>
    <!-- Para enlaces de salto accesibles: van antes del Header, primeros en el orden de tabulación -->
    <slot name="skip-link" />
    <Header activeDropdown={activeDropdown} activeNavLink={activeNavLink} />
    <main>
      <slot />
    </main>
    <Footer current={activeNavLink === "vacantes" ? "trabaja" : undefined} />
    <ToTopButton />

    <script>
      import { scrollToAnchorOnLoad } from "../scripts/scroll-to-anchor-on-load";
      scrollToAnchorOnLoad(72);
    </script>
  </body>
</html>
