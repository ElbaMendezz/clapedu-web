---
import PresupuestosLayout from "../layouts/PresupuestosLayout.astro";
import Navbar from "../components/presupuestos/Navbar.astro";
import Hero from "../components/presupuestos/Hero.astro";
import Beneficios from "../components/presupuestos/Beneficios.astro";
import Kit from "../components/presupuestos/Kit.astro";
import QueSon from "../components/presupuestos/QueSon.astro";
import Oferta from "../components/presupuestos/Oferta.astro";
import Requisitos from "../components/presupuestos/Requisitos.astro";
import Inscripcion from "../components/presupuestos/Inscripcion.astro";
import Faq from "../components/presupuestos/Faq.astro";
import BannerCierre from "../components/presupuestos/BannerCierre.astro";
import Footer from "../components/presupuestos/Footer.astro";
import ScrollToTop from "../components/presupuestos/ScrollToTop.astro";
---

<PresupuestosLayout
  title="Presupuestos Participativos"
  titleOverride="Presupuestos Participativos 2026 | Póngase Pilas · CLAP"
  description="Formación para el trabajo 100% gratuita y kit de herramientas para habitantes de Bucaramanga. Presupuestos Participativos 2026 · Alcaldía de Bucaramanga e IMEBU. Conozca la oferta de diplomados por barrio y cómo inscribirse."
  keywords="Presupuestos Participativos 2026, Póngase Pilas, Bucaramanga, IMEBU, Alcaldía de Bucaramanga, diplomados gratuitos, formación para el trabajo, kit de herramientas, inscripción"
  path="/presupuestos-participativos"
  breadcrumbs={[
    { name: "Inicio", path: "/" },
    { name: "Presupuestos Participativos", path: "/presupuestos-participativos" },
  ]}
>
  <Navbar />

  <main class="flex-1">
    <Hero />
    <Beneficios />
    <Kit />
    <QueSon />
    <Oferta />
    <Requisitos />
    <Inscripcion />
    <Faq />
    <BannerCierre />
  </main>

  <Footer />
  <ScrollToTop />
</PresupuestosLayout>

<script>
  import { attachReveal } from "../scripts/presupuestos-reveal";
  import { attachScrollLinks } from "../scripts/presupuestos-scroll-links";

  attachReveal();
  attachScrollLinks();
</script>
